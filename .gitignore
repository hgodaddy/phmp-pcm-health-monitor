# Build and run output. These stay anchored with a leading slash: an unanchored
# pattern such as "logs/" also matches source packages like
# src/main/java/com/poynt/phmp/logs/, which silently excludes them from commits.
/target/
/.allure/
/logs/
/reports/
/allure-results/
/allure-report/

# Local-only config
/local.properties
.env

# Editor and OS
.idea/
*.iml
.classpath
.project
.settings/
.vscode/
.DS_Store

# Binaries and transient caches
*.class
*.log
*.apk
*.bin
/.device-cache/
